          false,
          "ignore"
        ],
        [
          "abc/.hidden",
          false,
          "ignore"
        ]
      ]
    },
    {
      "name": "bare globstar",
      "patterns": "**\n",
      "cases": [
        [
          "file",
          false,
          "ignore"
        ],
        [
          "a/b/file",
          false,
          "ignore"
        ]
      ]
    },
    {
      "name": "globstar directory rule",
