{
  "path_scope": "matcher-relative",
  "case_format": [
    "path",
    "is_dir",
    "decision"
  ],
  "fixtures": [
    {
      "name": "basename wildcard",
      "patterns": "*.log\n",
      "cases": [
        [
          "app.log",
          false,
          "ignore"
        ],
        [
          "logs/app.log",
          false,
          "ignore"
        ],
        [
          "app.txt",
          false,
          "no_match"
        ],
        [
          ".trace.log",
          false,
          "ignore"
        ]
      ]
    },
    {
      "name": "single-character and segment wildcards",
      "patterns": "root/a*b\nroot/file?.txt\n",
      "cases": [
        [
          "root/ab",
          false,
          "ignore"
        ],
        [
          "root/axxb",
          false,
          "ignore"
        ],
        [
          "root/a/x/b",
          false,
          "no_match"
        ],
        [
          "root/file1.txt",
          false,
          "ignore"
        ],
        [
          "root/file.txt",
          false,
          "no_match"
        ],
        [
          "root/file12.txt",
          false,
          "no_match"
        ]
      ]
    },
    {
      "name": "question wildcard does not cross a separator",
      "patterns": "a?b\n",
      "cases": [
        [
          "acb",
          false,
          "ignore"
        ],
        [
          "a/b",
          false,
          "no_match"
        ]
      ]
    },
    {
      "name": "root anchoring",
      "patterns": "/secret\n",
      "cases": [
        [
          "secret",
          false,
          "ignore"
        ],
        [
          "dir/secret",
          false,
          "no_match"
        ]
      ]
    },
    {
      "name": "valid base-relative normalization",
      "patterns": "*.tmp\n",
      "cases": [
        [
          "./file.tmp",
          false,
          "ignore"
        ],
        [
          "a/../file.tmp",
          false,
          "ignore"
        ]
      ]
    },
    {
      "name": "slash makes pattern relative",
      "patterns": "doc/frotz\n",
      "cases": [
        [
          "doc/frotz",
          false,
          "ignore"
        ],
        [
          "a/doc/frotz",
          false,
          "no_match"
        ]
      ]
    },
    {
      "name": "directory basename and descendants",
      "patterns": "build/\n",
      "cases": [
        [
          "build",
          true,
          "ignore"
        ],
        [
          "build/output.txt",
          false,
          "ignore"
        ],
        [
          "src/build",
          true,
          "ignore"
        ],
        [
          "src/build/output.txt",
          false,
          "ignore"
        ]
      ]
    },
    {
      "name": "directory rule rejects file",
      "patterns": "build/\n",
      "cases": [
        [
          "build",
          false,
          "no_match"
        ]
      ]
    },
    {
      "name": "anchored directory has a segment boundary",
      "patterns": "/git/\n",
      "cases": [
        [
          "git",
          true,
          "ignore"
        ],
        [
          "git/config",
          false,
          "ignore"
        ],
        [
          "git-foo",
          true,
          "no_match"
        ],
        [
          "git-foo/config",
          false,
          "no_match"
        ]
      ]
    },
    {
      "name": "plain basename directory descendants",
      "patterns": "cache\n",
      "cases": [
        [
          "cache",
          true,
          "ignore"
        ],
        [
          "cache/item",
          false,
          "ignore"
        ],
        [
          "a/cache/item",
          false,
          "ignore"
        ]
      ]
    },
    {
      "name": "middle globstar",
      "patterns": "a/**/b\n",
      "cases": [
        [
          "a/b",
          false,
          "ignore"
        ],
        [
          "a/x/b",
          false,
          "ignore"
        ],
        [
          "a/x/y/b",
          false,
          "ignore"
        ],
        [
          "x/a/b",
          false,
          "no_match"
        ]
      ]
    },
    {
      "name": "leading globstar",
